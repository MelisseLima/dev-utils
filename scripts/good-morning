#!/usr/bin/env bash
# ☕ good-morning — wake up fresh: clean up Docker (soft or hard)
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

HARD_MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hard) HARD_MODE="true" ;;
    --help|-h)
      echo -e "${YELLOW}Usage: good-morning [--hard]${NC}"
      echo ""
      echo "  Default:   Remove dangling/unused images only (soft clean)."
      echo "  --hard:    Stop everything, remove all containers, images, volumes,"
      echo "             networks, and full system prune (nuclear)."
      exit 0
      ;;
    *) echo -e "${RED}  ✗ Unknown option: $1${NC}"; exit 1 ;;
  esac
  shift
done

banner() {
  echo ""
  echo -e "${CYAN}  ☀️  G O O D   M O R N I N G  ☀️${NC}"
  if [[ "$HARD_MODE" == "true" ]]; then
    echo -e "${YELLOW}  Time to kick Docker out of bed. ☠️  --hard mode${NC}"
  else
    echo -e "${YELLOW}  Just tidying up unused images.${NC}"
  fi
  echo ""
}

step() {
  echo -e "${GREEN}▸ $1${NC}"
}

warn() {
  echo -e "${YELLOW}  ⚠ $1${NC}"
}

banner

if [[ "$HARD_MODE" == "true" ]]; then
  # ===================== HARD MODE =====================

  # --- Stop all running containers ---
  running=$(docker ps -q 2>/dev/null || true)
  if [[ -n "$running" ]]; then
    step "Stopping all running containers..."
    docker stop $running
  else
    warn "No running containers — already sleeping."
  fi

  # --- Remove all containers (stopped included) ---
  all_containers=$(docker ps -aq 2>/dev/null || true)
  if [[ -n "$all_containers" ]]; then
    step "Removing all containers..."
    docker rm -f $all_containers
  else
    warn "No containers to remove."
  fi

  # --- Remove all images ---
  all_images=$(docker images -q 2>/dev/null || true)
  if [[ -n "$all_images" ]]; then
    step "Removing all images..."
    docker rmi -f $all_images
  else
    warn "No images to remove."
  fi

  # --- Remove all volumes ---
  all_volumes=$(docker volume ls -q 2>/dev/null || true)
  if [[ -n "$all_volumes" ]]; then
    step "Removing all volumes..."
    docker volume rm -f $all_volumes
  else
    warn "No volumes to remove."
  fi

  # --- Remove all networks (except defaults) ---
  custom_networks=$(docker network ls --filter type=custom -q 2>/dev/null || true)
  if [[ -n "$custom_networks" ]]; then
    step "Removing custom networks..."
    docker network rm $custom_networks 2>/dev/null || true
  else
    warn "No custom networks to remove."
  fi

  # --- Final prune for good measure ---
  step "Running system prune for anything left behind..."
  docker system prune -af --volumes 2>/dev/null || true

  echo ""
  echo -e "${CYAN}  ✅  All clean! Docker is fresh like a new day.${NC}"
  echo -e "${CYAN}  ☕  Now go grab some coffee.${NC}"
  echo ""

else
  # ===================== SOFT MODE (default) =====================

  # --- Remove dangling images (untagged, not used by any container) ---
  dangling=$(docker images -f "dangling=true" -q 2>/dev/null || true)
  if [[ -n "$dangling" ]]; then
    step "Removing dangling images..."
    docker rmi $dangling 2>/dev/null || true
  else
    warn "No dangling images."
  fi

  # --- Remove images not used by any running or stopped container ---
  step "Pruning unused images..."
  docker image prune -af 2>/dev/null || true

  echo ""
  echo -e "${CYAN}  ✅  Unused images cleaned up!${NC}"
  echo -e "${CYAN}  ☕  Run 'good-morning --hard' for a full nuclear clean.${NC}"
  echo ""
fi
